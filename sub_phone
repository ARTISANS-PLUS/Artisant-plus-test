function locateAndSearch(){
  const trade = document.getElementById("searchTrade").value.trim();
  if(!trade){ toast("Précisez le métier recherché.","err"); return; }
  const statusEl = document.getElementById("gpsStatusSearch");
  statusEl.textContent = "📡 Localisation en cours…"; statusEl.className="gps-status";
  if(!navigator.geolocation){ statusEl.textContent="GPS non supporté par ce navigateur."; statusEl.className="gps-status err"; return; }
  navigator.geolocation.getCurrentPosition(pos=>{
    const clientPos = {lat:pos.coords.latitude, lng:pos.coords.longitude};
    const u = currentUser(); u.gps = clientPos; saveDB(DB);
    statusEl.textContent = "✅ Position détectée"; statusEl.className="gps-status ok";
    showSearchResults(trade, clientPos);
  }, err=>{
    statusEl.textContent = "⚠️ Impossible d'obtenir la position ("+err.message+"). Utilisation d'une position de démonstration (Abidjan).";
    statusEl.className="gps-status err";
    const fallback = {lat:5.3364,lng:-4.0267};
    const u = currentUser(); u.gps = fallback; saveDB(DB);
    showSearchResults(trade, fallback);
  }, {enableHighAccuracy:true, timeout:8000});
}
function showSearchResults(trade, clientPos){
  const matches = DB.users.filter(a=>a.role==="artisan" && a.available && a.gps &&
      a.trades && a.trades.some(t=>t.toLowerCase().includes(trade.toLowerCase())))
    .map(a=>({...a, dist: haversine(clientPos, a.gps)}))
    .sort((a,b)=>a.dist-b.dist);
  const wrap = document.getElementById("searchResults");
  if(!matches.length){
    wrap.innerHTML = `<div class="empty-state"><div class="icon-badge">🔍</div>Aucun artisan disponible pour « ${trade} » pour le moment. Réessayez plus tard.</div>`;
    return;
  }
  wrap.innerHTML = `<h3>${matches.length} artisan(s) trouvé(s)</h3>` + matches.map(a=>`
    <div class="artisan-result">
      <div class="avatar">${a.name.split(" ").map(w=>w[0]).join("").slice(0,2)}</div>
