   ========================================================================================= */
function renderAppShell(path, params){
  const u = currentUser();
  buildSidebar(u, path);
  const main = document.getElementById("mainArea");

  if(u.role==="client"){
    if(u.subscription?.status!=="active" && !path.startsWith("/client/onboarding")){
      openSubscriptionModal("client");
    }
    if(path==="/client") return renderClientHome(main, u);
    if(path==="/client/search") return renderClientSearch(main, u);
    if(path.startsWith("/client/task/")) return renderClientTask(main, u, path.split("/").pop());
    if(path==="/client/wallet") return renderWalletView(main, u);
    if(path==="/client/history") return renderClientHistory(main, u);
    if(path==="/client/profile") return renderProfileView(main, u);
    return renderClientHome(main,u);
  }
  if(u.role==="artisan"){
    if(params.get("onboarding") || !u.trades || u.trades.length===0 || !u.gps){
      return renderArtisanOnboarding(main, u);
    }
  if(u.subscription?.status!=="active"){ openSubscriptionModal("artisan"); }
    if(path==="/artisan") return renderArtisanHome(main, u);
    if(path==="/artisan/requests") return renderArtisanRequests(main, u);
    if(path.startsWith("/artisan/task/")) return renderArtisanTask(main, u, path.split("/").pop());
    if(path==="/artisan/wallet") return renderWalletView(main, u);
    if(path==="/artisan/profile") return renderArtisanProfile(main, u);
    if(path==="/artisan/history") return renderArtisanHistory(main, u);
    return renderArtisanHome(main,u);
  }
  if(u.role==="admin"){
    if(path==="/admin") return renderAdminHome(main);
    if(path==="/admin/users") return renderAdminUsers(main);
    if(path==="/admin/tasks") return renderAdminTasks(main);
    return renderAdminHome(main);
  }
}

