<!DOCTYPE html>
<html lang="fr">
<head>
<script type="module" src="supabase-client.js"></script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>Artisans+ | Trouvez un artisan de confiance près de chez vous</title>
<meta name="description" content="Artisans+ met en relation clients et artisans qualifiés au Togo, Bénin, Côte d'Ivoire, Sénégal, Burkina Faso, Mali et Rwanda.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='32' fill='%23161F38'/%3E%3Cpath d='M32 14l6.5 12.9L52 29l-10 9.6L44.5 52 32 45.2 19.5 52 22 38.6 12 29l13.5-2.1z' fill='%23E8A33D'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,900&family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<style>
/* =========================================================
   ARTISANS+ — DESIGN TOKENS
   Palette inspirée des textiles wax & du bogolan ouest-africain :
   indigo profond, ocre, terre cuite, émeraude, crème.
   ========================================================= */
:root{
  --indigo:#141B33;
  --indigo-2:#1E2A4D;
  --indigo-3:#283968;
  --cream:#F8F1E1;
  --paper:#FFFCF6;
  --ochre:#E8A33D;
  --ochre-dark:#C97F1F;
  --clay:#C15A3B;
  --emerald:#2F6D5C;
  --emerald-dark:#204E42;
  --ink:#1B1A17;
  --muted:#6B6455;
  --line:#E7DDC7;
  --danger:#B3402C;
  --radius:14px;
  --shadow:0 10px 30px rgba(20,27,51,.12);
  --font-display:'Fraunces', serif;
  --font-body:'Manrope', sans-serif;
  --font-mono:'IBM Plex Mono', monospace;
}
*,*::before,*::after{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0; font-family:var(--font-body); color:var(--ink); background:var(--paper);
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,h4{font-family:var(--font-display); margin:0 0 .4em; font-weight:700; letter-spacing:-.01em;}
p{line-height:1.55; color:var(--muted);}
a{color:inherit;}
button{font-family:var(--font-body); cursor:pointer;}
.mono{font-family:var(--font-mono);}
img{max-width:100%;display:block;}
::selection{background:var(--ochre); color:var(--indigo);}
:focus-visible{outline:3px solid var(--ochre); outline-offset:2px;}
@media (prefers-reduced-motion: reduce){ *{animation-duration:.001ms !important; transition-duration:.001ms !important;} }

/* Layout helpers */
.wrap{max-width:1180px; margin:0 auto; padding:0 24px;}
.hidden{display:none !important;}
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  padding:13px 22px; border-radius:999px; border:none; font-weight:700; font-size:.95rem;
  transition:transform .15s ease, box-shadow .15s ease; text-decoration:none;
}
.btn:active{transform:translateY(1px);}
.btn-primary{background:var(--ochre); color:var(--indigo); box-shadow:0 6px 18px rgba(232,163,61,.35);}
.btn-primary:hover{background:var(--ochre-dark);}
.btn-dark{background:var(--indigo); color:var(--cream);}
.btn-dark:hover{background:var(--indigo-2);}
.btn-outline{background:transparent; border:1.5px solid var(--indigo); color:var(--indigo);}
.btn-outline:hover{background:var(--indigo); color:var(--cream);}
.btn-emerald{background:var(--emerald); color:#fff;}
.btn-emerald:hover{background:var(--emerald-dark);}
.btn-danger{background:var(--danger); color:#fff;}
.btn-ghost{background:transparent;border:none;color:var(--indigo);text-decoration:underline;padding:6px 4px;font-weight:600;}
.btn-sm{padding:8px 16px; font-size:.82rem; border-radius:999px;}
.btn-block{width:100%;}
.pill{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;}
.pill-ochre{background:rgba(232,163,61,.18); color:var(--ochre-dark);}
.pill-emerald{background:rgba(47,109,92,.14); color:var(--emerald-dark);}
.pill-clay{background:rgba(193,90,59,.14); color:var(--clay);}
.pill-muted{background:#EFEAE0; color:var(--muted);}

/* Wax-print divider (signature motif) */
.wax-divider{
  height:14px; width:100%;
  background-image:repeating-linear-gradient(135deg, var(--ochre) 0 8px, var(--clay) 8px 16px, var(--indigo) 16px 24px);
  opacity:.9;
}

/* ===================== NAV ===================== */
.topnav{
  position:sticky; top:0; z-index:50; background:rgba(248,241,225,.92); backdrop-filter:blur(8px);
  border-bottom:1px solid var(--line);
}
.topnav .wrap{display:flex; align-items:center; justify-content:space-between; height:72px;}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:800;font-size:1.3rem;color:var(--indigo);text-decoration:none;}
.brand svg{width:34px;height:34px;}
.navlinks{display:flex;align-items:center;gap:26px;font-weight:600;font-size:.92rem;}
.navlinks a{cursor:pointer;}
.nav-actions{display:flex;align-items:center;gap:10px;}
.bell-wrap{position:relative;}
.bell-btn{background:none;border:none;font-size:1.3rem;position:relative;padding:6px;}
.bell-dot{position:absolute; top:2px; right:2px; width:9px;height:9px;border-radius:50%;background:var(--clay); border:2px solid var(--cream);}
.dropdown{position:absolute; right:0; top:44px; width:320px; background:var(--paper); border:1px solid var(--line); border-radius:12px; box-shadow:var(--shadow); padding:8px; max-height:400px; overflow:auto;}
.dropdown .item{padding:10px 12px; border-radius:8px; font-size:.85rem;}
.dropdown .item:hover{background:#F1EADA;}
.dropdown .item b{display:block;color:var(--indigo);}

/* ===================== HERO ===================== */
.hero{background:radial-gradient(1200px 600px at 80% -10%, #24325C 0%, var(--indigo) 55%, #0F1526 100%); color:var(--cream); position:relative; overflow:hidden;}
.hero .wrap{display:grid; grid-template-columns:1.1fr .9fr; gap:50px; align-items:center; padding:80px 24px 90px;}
.eyebrow{font-family:var(--font-mono); font-size:.78rem; letter-spacing:.14em; text-transform:uppercase; color:var(--ochre); margin-bottom:16px; display:flex; align-items:center; gap:10px;}
.eyebrow::before{content:"";width:26px;height:2px;background:var(--ochre);display:inline-block;}
.hero h1{font-size:3.1rem; line-height:1.04; color:#fff; max-width:640px;}
.hero h1 em{font-style:italic; color:var(--ochre);}
.hero p.lead{color:#C9CEE0; font-size:1.08rem; max-width:520px; margin-bottom:28px;}
.hero-ctas{display:flex; gap:14px; flex-wrap:wrap;}
.hero-stats{display:flex; gap:34px; margin-top:44px; flex-wrap:wrap;}
.hero-stats div b{display:block; font-family:var(--font-mono); font-size:1.5rem; color:var(--ochre);}
.hero-stats div span{font-size:.78rem; color:#9AA2C0;}

/* Radar / GPS signature element */
.radar-card{background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.14); border-radius:20px; padding:26px; backdrop-filter:blur(6px);}
.radar-box{position:relative; width:100%; aspect-ratio:1/1; max-width:320px; margin:0 auto; display:flex; align-items:center; justify-content:center;}
.radar-ring{position:absolute; border:1px solid rgba(232,163,61,.35); border-radius:50%;}
.radar-ring.r1{inset:0;}
.radar-ring.r2{inset:15%;}
.radar-ring.r3{inset:30%;}
.radar-sweep{position:absolute; inset:0; border-radius:50%; background:conic-gradient(from 0deg, rgba(232,163,61,.55), transparent 35%); animation:spin 3.2s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.radar-center{width:14px;height:14px;background:var(--ochre); border-radius:50%; box-shadow:0 0 0 6px rgba(232,163,61,.25); z-index:2;}
.radar-dot{position:absolute; width:10px;height:10px;border-radius:50%; background:var(--emerald); box-shadow:0 0 0 5px rgba(47,109,92,.3);}
.radar-caption{text-align:center; font-family:var(--font-mono); font-size:.75rem; color:#B9C0DE; margin-top:14px;}

/* ===================== SECTIONS ===================== */
section{padding:86px 0;}
.section-head{max-width:640px; margin-bottom:48px;}
.section-head .eyebrow{color:var(--clay);}
.section-head h2{font-size:2.2rem; color:var(--indigo);}
.grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:24px;}
.grid-2{display:grid; grid-template-columns:1fr 1fr; gap:24px;}
.card{background:var(--paper); border:1px solid var(--line); border-radius:var(--radius); padding:28px; box-shadow:var(--shadow);}
.card h3{font-size:1.15rem; color:var(--indigo);}
.icon-badge{width:48px;height:48px;border-radius:12px;background:rgba(47,109,92,.12); display:flex;align-items:center;justify-content:center; font-size:1.4rem; margin-bottom:16px;}

.how-steps{counter-reset:step; display:grid; grid-template-columns:repeat(4,1fr); gap:22px;}
.how-step{position:relative; padding-top:10px;}
.how-step .num{font-family:var(--font-mono); font-size:.85rem; color:var(--clay); font-weight:700;}
.how-step h4{color:var(--indigo); margin:8px 0 6px; font-size:1.05rem;}

.trades-band{background:var(--indigo); color:var(--cream);}
.trades-band .section-head h2{color:#fff;}
.trades-band .section-head p{color:#AEB4D2;}
.trade-chips{display:flex; flex-wrap:wrap; gap:10px;}
.trade-chip{background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); padding:8px 14px; border-radius:999px; font-size:.82rem;}

.pricing-band .grid-2{grid-template-columns:1fr 1fr;}
.price-card{border-radius:18px; padding:32px; position:relative; overflow:hidden;}
.price-card.client{background:linear-gradient(160deg,#FBF3E3,#F3E4C8); border:1px solid var(--line);}
.price-card.artisan{background:linear-gradient(160deg,var(--indigo),#232F55); color:#fff;}
.price-card .tier{display:flex; justify-content:space-between; align-items:baseline; margin:18px 0;}
.price-card .tier .amt{font-family:var(--font-mono); font-size:1.5rem; font-weight:700;}
.price-card ul{padding-left:18px; margin:14px 0;}
.price-card li{margin-bottom:6px; font-size:.9rem;}

footer{background:var(--indigo); color:#AEB4D2; padding:50px 0 30px; font-size:.88rem;}
footer .wrap{display:flex; justify-content:space-between; flex-wrap:wrap; gap:20px;}
footer a{opacity:.85;} footer a:hover{opacity:1;}

/* ===================== APP SHELL (dashboard) ===================== */
.app-shell{display:none; min-height:100vh; background:#F3EEE1;}
.app-shell.active{display:grid; grid-template-columns:260px 1fr;}
.sidebar{background:var(--indigo); color:var(--cream); padding:24px 18px; display:flex; flex-direction:column; gap:6px;}
.sidebar .brand{color:#fff; margin-bottom:18px;}
.side-link{display:flex; align-items:center; gap:10px; padding:11px 14px; border-radius:10px; font-size:.9rem; font-weight:600; color:#C9CEE0; text-decoration:none; background:none; border:none; text-align:left; width:100%;}
.side-link:hover{background:rgba(255,255,255,.06); color:#fff;}
.side-link.active{background:rgba(232,163,61,.16); color:var(--ochre);}
.side-foot{margin-top:auto; font-size:.75rem; color:#7A81A6; padding:10px 14px;}
.main-area{padding:26px 32px 60px; max-width:1080px;}
.main-head{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:26px; flex-wrap:wrap; gap:12px;}
.main-head h1{font-size:1.7rem; color:var(--indigo);}
.stat-row{display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:26px;}
.stat-box{background:var(--paper); border:1px solid var(--line); border-radius:12px; padding:18px;}
.stat-box b{display:block; font-family:var(--font-mono); font-size:1.4rem; color:var(--indigo);}
.stat-box span{font-size:.78rem; color:var(--muted);}

.table{width:100%; border-collapse:collapse; background:var(--paper); border-radius:12px; overflow:hidden; border:1px solid var(--line);}
.table th,.table td{padding:12px 14px; text-align:left; font-size:.86rem; border-bottom:1px solid var(--line);}
.table th{background:#EFE7D3; color:var(--indigo); font-family:var(--font-mono); font-size:.72rem; text-transform:uppercase; letter-spacing:.05em;}
.table tr:last-child td{border-bottom:none;}
.table td .btn-sm{margin-right:6px;}

.form-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
.field{display:flex; flex-direction:column; gap:6px; margin-bottom:16px;}
.field.full{grid-column:1/-1;}
.field label{font-size:.82rem; font-weight:700; color:var(--indigo);}
.field small{color:var(--muted); font-size:.76rem;}
input,select,textarea{
  font-family:var(--font-body); padding:11px 13px; border-radius:9px; border:1.5px solid var(--line);
  background:#fff; font-size:.92rem; width:100%;
}
input:focus,select:focus,textarea:focus{border-color:var(--ochre);}
.phone-row{display:flex; gap:8px;}
.phone-row select{max-width:140px;}
.checkbox-row{display:flex; align-items:center; gap:8px; font-size:.86rem;}
.checkbox-row input{width:auto;}

.tabs{display:flex; gap:6px; margin-bottom:22px; border-bottom:1.5px solid var(--line);}
.tab-btn{background:none;border:none;padding:11px 18px;font-weight:700;font-size:.88rem;color:var(--muted); border-bottom:3px solid transparent; margin-bottom:-1.5px;}
.tab-btn.active{color:var(--indigo); border-color:var(--ochre);}

.trade-select-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:8px; max-height:280px; overflow:auto; border:1.5px solid var(--line); border-radius:10px; padding:12px; background:#fff;}
.trade-select-grid label{display:flex; gap:8px; align-items:center; font-size:.82rem; font-weight:500; color:var(--ink);}
.trade-select-grid input{width:auto;}

.artisan-result{display:flex; gap:16px; align-items:center; background:var(--paper); border:1px solid var(--line); border-radius:12px; padding:16px; margin-bottom:12px;}
.avatar{width:52px;height:52px;border-radius:50%;background:var(--emerald); color:#fff; display:flex;align-items:center;justify-content:center; font-weight:700; font-family:var(--font-display); font-size:1.2rem; flex-shrink:0;}
.artisan-result .info{flex:1;}
.artisan-result .info h4{margin:0 0 2px; color:var(--indigo); font-size:1rem;}
.stars{color:var(--ochre); font-size:.85rem;}
.dist-badge{font-family:var(--font-mono); font-size:.78rem; color:var(--emerald-dark); font-weight:700;}

.task-track-map{height:320px; border-radius:14px; overflow:hidden; border:1px solid var(--line); margin-bottom:16px;}
.progress-bar{height:10px; background:#EFE7D3; border-radius:99px; overflow:hidden; margin:14px 0;}
.progress-bar > div{height:100%; background:linear-gradient(90deg,var(--emerald),var(--ochre)); transition:width .4s ease;}
.status-timeline{display:flex; justify-content:space-between; margin:20px 0; font-size:.75rem; color:var(--muted);}
.status-timeline .st{text-align:center; flex:1; position:relative;}
.status-timeline .st .dot{width:14px;height:14px;border-radius:50%;background:#DCD3BB; margin:0 auto 6px;}
.status-timeline .st.done .dot{background:var(--emerald);}
.status-timeline .st.now .dot{background:var(--ochre); box-shadow:0 0 0 4px rgba(232,163,61,.3);}

.wallet-box{background:linear-gradient(135deg,var(--indigo),#2A3A6B); color:#fff; border-radius:16px; padding:26px; margin-bottom:24px;}
.wallet-box .bal{font-family:var(--font-mono); font-size:2.1rem; font-weight:700; color:var(--ochre);}
.wallet-methods{display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin:14px 0;}
.pm-btn{border:1.5px solid var(--line); background:#fff; border-radius:10px; padding:12px 8px; font-size:.78rem; font-weight:700; text-align:center;}
.pm-btn.selected{border-color:var(--ochre); background:rgba(232,163,61,.12); color:var(--ochre-dark);}

.rating-stars{font-size:2rem; letter-spacing:6px; cursor:pointer; color:#DCD3BB;}
.rating-stars span.active{color:var(--ochre);}

.modal-overlay{position:fixed; inset:0; background:rgba(20,27,51,.55); display:flex; align-items:center; justify-content:center; z-index:200; padding:20px;}
.modal{background:var(--paper); border-radius:16px; padding:30px; max-width:460px; width:100%; max-height:88vh; overflow:auto; box-shadow:var(--shadow);}
.modal h3{color:var(--indigo);}
.modal-close{float:right; background:none;border:none;font-size:1.3rem;color:var(--muted);}

.toast-wrap{position:fixed; top:20px; right:20px; z-index:400; display:flex; flex-direction:column; gap:10px;}
.toast{background:var(--indigo); color:#fff; padding:14px 18px; border-radius:10px; font-size:.86rem; box-shadow:var(--shadow); border-left:4px solid var(--ochre); animation:slidein .25s ease;}
.toast.err{border-left-color:var(--danger);}
.toast.ok{border-left-color:var(--emerald);}
@keyframes slidein{from{transform:translateX(30px);opacity:0;} to{transform:translateX(0);opacity:1;}}

.empty-state{text-align:center; padding:60px 20px; color:var(--muted);}
.empty-state .icon-badge{margin:0 auto 16px;}

.gps-status{display:flex; align-items:center; gap:8px; font-size:.82rem; padding:10px 14px; border-radius:9px; background:#EFEAE0; margin-bottom:14px;}
.gps-status.ok{background:rgba(47,109,92,.12); color:var(--emerald-dark);}
.gps-status.err{background:rgba(179,64,44,.12); color:var(--danger);}

.badge-verified{display:inline-flex; align-items:center; gap:4px; font-size:.7rem; background:rgba(47,109,92,.14); color:var(--emerald-dark); padding:3px 8px; border-radius:99px; font-weight:700;}
.sos-btn{position:fixed; bottom:24px; right:24px; background:var(--danger); color:#fff; border:none; width:56px;height:56px;border-radius:50%; font-size:1.3rem; box-shadow:0 8px 22px rgba(179,64,44,.4); z-index:100;}

@media (max-width:900px){
  .hero .wrap{grid-template-columns:1fr; padding-top:50px;}
  .hero h1{font-size:2.2rem;}
  .grid-3,.grid-2,.how-steps,.pricing-band .grid-2,.stat-row{grid-template-columns:1fr;}
  .navlinks{display:none;}
  .app-shell.active{grid-template-columns:1fr;}
  .sidebar{display:flex; flex-direction:row; overflow-x:auto; align-items:center;}
  .side-foot{display:none;}
  .form-grid{grid-template-columns:1fr;}
  .main-area{padding:20px 16px 60px;}
}
</style>
</head>
<body>

<!-- =========================================================
     MARKETING SITE (public, non connecté)
     ========================================================= -->
<div id="site">
  <header class="topnav">
    <div class="wrap">
      <a class="brand" href="#/" onclick="go('/')">
        <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="32" fill="#141B33"/><path d="M32 14l6.5 12.9L52 29l-10 9.6L44.5 52 32 45.2 19.5 52 22 38.6 12 29l13.5-2.1z" fill="#E8A33D"/></svg>
        Artisans<span style="color:var(--ochre)">+</span>
      </a>
      <nav class="navlinks">
        <a onclick="scrollToId('comment')">Comment ça marche</a>
        <a onclick="scrollToId('metiers')">Métiers</a>
        <a onclick="scrollToId('tarifs')">Tarifs</a>
        <a onclick="scrollToId('pays')">Pays couverts</a>
      </nav>
      <div class="nav-actions">
        <button class="btn btn-outline btn-sm" onclick="go('/login')">Connexion</button>
        <button class="btn btn-primary btn-sm" onclick="go('/register')">Créer un compte</button>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="wrap">
      <div>
        <div class="eyebrow">7 pays · Afrique de l'Ouest & Rwanda</div>
        <h1>L'artisan qu'il vous faut, <em>géolocalisé</em>, en quelques minutes.</h1>
        <p class="lead">Menuisier, électricien, plombier, frigoriste, maçon… Artisans+ trouve l'artisan disponible le plus proche de vous, suit son trajet en temps réel et sécurise le paiement via mobile money ou carte.</p>
        <div class="hero-ctas">
          <button class="btn btn-primary" onclick="go('/register?role=client')">Je cherche un artisan</button>
          <button class="btn btn-dark" onclick="go('/register?role=artisan')">Je suis artisan</button>
        </div>
        <div class="hero-stats">
          <div><b id="statTrades">70+</b><span>métiers référencés</span></div>
          <div><b>7</b><span>pays actifs</span></div>
          <div><b>&lt;15min</b><span>délai moyen de mise en relation</span></div>
        </div>
      </div>
      <div class="radar-card">
        <div class="radar-box">
          <div class="radar-ring r1"></div><div class="radar-ring r2"></div><div class="radar-ring r3"></div>
          <div class="radar-sweep"></div>
          <div class="radar-dot" style="top:20%;left:60%;"></div>
          <div class="radar-dot" style="top:65%;left:30%;"></div>
          <div class="radar-dot" style="top:40%;left:75%;"></div>
          <div class="radar-center"></div>
        </div>
        <div class="radar-caption">RECHERCHE EN COURS · 4 ARTISANS PLOMBIER À MOINS DE 3KM</div>
      </div>
    </div>
  </section>

  <div class="wax-divider"></div>

