function statusTimelineHtml(status){
  const steps=[["pending","Demande envoyée"],["accepted","Acceptée"],["enroute","En route"],["arrived","Arrivé"],["in_progress","Prestation"],["paid","Payé"],["closed","Clôturé"]];
  const order = steps.map(s=>s[0]);
  const curIdx = order.indexOf(status);
  return `<div class="status-timeline">${steps.map(([key,label],i)=>`<div class="st ${i<curIdx?'done':''} ${i===curIdx?'now':''}"><div class="dot"></div>${label}</div>`).join("")}</div>`;
}
let __taskMapInstance=null, __taskMarkerArtisan=null, __routeTimer=null;
function initTaskMap(t){
  if(__taskMapInstance){ __taskMapInstance.remove(); __taskMapInstance=null; }
  const clientPos = t.clientGPS || {lat:6.13,lng:1.22};
  const map = L.map('taskMap').setView([clientPos.lat, clientPos.lng], 13);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {attribution:'© OpenStreetMap'}).addTo(map);
  const clientIcon = L.divIcon({className:'', html:'<div style="background:#2F6D5C;width:16px;height:16px;border-radius:50%;border:3px solid white;box-shadow:0 0 0 3px rgba(47,109,92,.35)"></div>'});
  const artIcon = L.divIcon({className:'', html:'<div style="background:#E8A33D;width:16px;height:16px;border-radius:50%;border:3px solid white;box-shadow:0 0 0 3px rgba(232,163,61,.35)"></div>'});
  L.marker([clientPos.lat, clientPos.lng], {icon:clientIcon}).addTo(map).bindPopup("Vous");
  const artPos = t.artisanGPS || clientPos;
  __taskMarkerArtisan = L.marker([artPos.lat, artPos.lng], {icon:artIcon}).addTo(map).bindPopup("Artisan");
  const bounds = L.latLngBounds([[clientPos.lat,clientPos.lng],[artPos.lat,artPos.lng]]);
  map.fitBounds(bounds, {padding:[40,40]});
  __taskMapInstance = map;
  if(t.status==="enroute" || t.status==="accepted"){ startRouteSimulation(t); }
}
function startRouteSimulation(t){
  if(__routeTimer) clearInterval(__routeTimer);
  const clientPos = t.clientGPS, artPos = t.artisanGPS;
  __routeTimer = setInterval(()=>{
    const cur = DB.tasks.find(x=>x.id===t.id);
    if(!cur || !["accepted","enroute"].includes(cur.status)){ clearInterval(__routeTimer); return; }
    cur.route = Math.min(100, (cur.route||0) + 8);
    const lat = artPos.lat + (clientPos.lat-artPos.lat)*(cur.route/100);
    const lng = artPos.lng + (clientPos.lng-artPos.lng)*(cur.route/100);
    if(__taskMarkerArtisan) __taskMarkerArtisan.setLatLng([lat,lng]);
    cur.status = "enroute";
    const bar = document.getElementById("routeProgressBar");
    if(bar) bar.style.width = cur.route+"%";
    const eta = document.getElementById("routeEta");
    if(eta) eta.textContent = Math.max(0, Math.round((100-cur.route)/8*3)) + " min restantes (estimation)";
    saveDB(DB);
    if(cur.route>=100){ clearInterval(__routeTimer); }
  }, 1200);
}
