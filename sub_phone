    <div class="card">
      <div class="trade-select-grid" id="editTradeGrid">${FLAT_TRADES.map(t=>`<label><input type="checkbox" value="${t}" ${u.trades.includes(t)?'checked':''}> ${t}</label>`).join("")}</div>
      <div class="field" style="margin-top:14px;"><label>Prix minimum du service (frais de retrait inclus)</label><input id="editPrice" type="number" value="${u.minPrice}"></div>
      <button class="btn btn-dark btn-sm" onclick="saveArtisanProfile()">Enregistrer les modifications</button>
    </div>`;
}
function saveArtisanProfile(){
  const trades = Array.from(document.querySelectorAll("#editTradeGrid input:checked")).map(i=>i.value);
  const price = parseFloat(document.getElementById("editPrice").value);
  const u = currentUser(); u.trades=trades; u.minPrice=price; saveDB(DB);
  toast("Profil mis à jour.","ok"); render();
}

/* ---------------- ADMIN VIEWS ---------------- */
function renderAdminHome(main){
  const clients = DB.users.filter(u=>u.role==="client");
  const artisans = DB.users.filter(u=>u.role==="artisan");
  const subsRevenue = DB.users.reduce((sum,u)=>{
    if(u.role==="client" && u.subscription.status==="active") sum += u.subscription.plan==="essai"?1500:7000;
    if(u.role==="artisan" && u.subscription.status==="active") sum += u.subscription.plan==="essai"?2000:10000;
    return sum;
  },0);
  const commissionRevenue = DB.tasks.reduce((s,t)=>s+(t.commission||0),0);
  const activeTasks = DB.tasks.filter(t=>!["closed","cancelled"].includes(t.status)).length;
  main.innerHTML = `
    <div class="main-head"><h1>Vue d'ensemble — Administration</h1></div>
    <div class="stat-row">
      <div class="stat-box"><b>${clients.length}</b><span>Clients inscrits</span></div>
      <div class="stat-box"><b>${artisans.length}</b><span>Artisans inscrits</span></div>
      <div class="stat-box"><b>${fmtMoney(subsRevenue)}</b><span>Revenus abonnements (actifs)</span></div>
      <div class="stat-box"><b>${fmtMoney(commissionRevenue)}</b><span>Revenus commissions</span></div>
    </div>
    <div class="stat-row">
      <div class="stat-box"><b>${activeTasks}</b><span>Tâches en cours</span></div>
      <div class="stat-box"><b>${DB.tasks.length}</b><span>Tâches totales</span></div>
      <div class="stat-box"><b>${artisans.filter(a=>a.available).length}</b><span>Artisans disponibles</span></div>
      <div class="stat-box"><b>${artisans.filter(a=>a.verified).length}</b><span>Artisans vérifiés</span></div>
    </div>
    <h3>Répartition par pays</h3>
    <table class="table"><thead><tr><th>Pays</th><th>Clients</th><th>Artisans</th></tr></thead>
    <tbody>${Object.entries(COUNTRIES).map(([k,c])=>`<tr><td>${c.flag} ${c.name}</td><td>${clients.filter(u=>u.countryCode===k).length}</td><td>${artisans.filter(u=>u.countryCode===k).length}</td></tr>`).join("")}</tbody></table>
  `;
}
function renderAdminUsers(main){
  const users = DB.users.filter(u=>u.role!=="admin");
  main.innerHTML = `<div class="main-head"><h1>Utilisateurs</h1></div>
    <table class="table"><thead><tr><th>Nom</th><th>Rôle</th><th>Pays</th><th>Abonnement</th><th>Statut</th><th></th></tr></thead>
    <tbody>${users.map(u=>`<tr><td>${u.name}<br><span style="color:var(--muted);font-size:.78rem;">${u.email}</span></td><td><span class="pill pill-muted">${u.role}</span></td><td>${COUNTRIES[u.countryCode]?.flag||''} ${COUNTRIES[u.countryCode]?.name||'—'}</td><td>${u.subscription?.status==='active'?`<span class="pill pill-emerald">${u.subscription.plan}</span>`:`<span class="pill pill-clay">inactif</span>`}</td><td>${u.blocked?'<span class="pill pill-clay">Suspendu</span>':'<span class="pill pill-emerald">Actif</span>'}</td><td><button class="btn btn-outline btn-sm" onclick="toggleBlockUser('${u.id}')">${u.blocked?'Réactiver':'Suspendre'}</button></td></tr>`).join("")}</tbody></table>`;
}
function toggleBlockUser(id){
  const u = DB.users.find(x=>x.id===id); u.blocked = !u.blocked; saveDB(DB); toast("Statut mis à jour.","ok"); render();
}
function renderAdminTasks(main){
  const tasks = DB.tasks.sort((a,b)=>b.createdAt-a.createdAt);
  main.innerHTML = `<div class="main-head"><h1>Toutes les tâches</h1></div>
    <table class="table"><thead><tr><th>Métier</th><th>Client</th><th>Artisan</th><th>Statut</th><th>Prix</th><th>Commission</th></tr></thead>
    <tbody>${tasks.map(t=>{
      const c = DB.users.find(x=>x.id===t.clientId), a = DB.users.find(x=>x.id===t.artisanId);
      return `<tr><td>${t.trade}</td><td>${c?.name||'—'}</td><td>${a?.name||'—'}</td><td><span class="pill pill-muted">${statusLabel(t.status)}</span></td><td class="mono">${fmtMoney(t.price)}</td><td class="mono">${t.commission?fmtMoney(t.commission):'—'}</td></tr>`;
    }).join("") || `<tr><td colspan="6" style="text-align:center;color:var(--muted);">Aucune tâche.</td></tr>`}</tbody></table>`;
}
</script>
</body>
</html>
