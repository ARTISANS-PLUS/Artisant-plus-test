  navigator.geolocation.getCurrentPosition(pos=>{
    window.__obGps = {lat:pos.coords.latitude, lng:pos.coords.longitude};
    statusEl.textContent="✅ Position enregistrée ("+pos.coords.latitude.toFixed(4)+", "+pos.coords.longitude.toFixed(4)+")";
