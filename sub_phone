async function loadUserProfile(userId){
  const { data: profile, error } = await window.supabase
    .from("profiles")
    .select("*")
    .eq("id", userId)
    .single();

  if(error){
    console.error("Erreur de récupération du profil :", error);
    return null;
  }

  if(!profile) return null;

  let user = {
    id: profile.id,
    name: profile.full_name,
    email: profile.email,
    phone: profile.phone,
    role: profile.role,
    blocked: profile.is_suspended
  };

  if(profile.role === "artisan"){
    const { data: artisanProfile, error: artisanError } = await window.supabase
      .from("artisan_profiles")
      .select("*")
      .eq("user_id", userId)
      .maybeSingle();

    if(artisanError){
      console.error("Erreur de récupération du profil artisan :", artisanError);
    }

    if(artisanProfile){
      user.trades = artisanProfile.trades;
      user.bio = artisanProfile.bio;
      user.minPrice = artisanProfile.min_price;
      user.available = artisanProfile.is_available;
      user.verified = artisanProfile.is_verified;
      user.rating = artisanProfile.rating;
      user.ratingsCount = artisanProfile.rating_count;
    }
  }

  AUTH_USER = user;
  return user;
}

async function initializeSupabaseAuth(){
  if(!window.supabase){
    console.error("Supabase n'est pas disponible.");
    AUTH_READY = true;
    render();
    return;
  }

  const { data, error } = await window.supabase.auth.getSession();

  if(error){
    console.error("Erreur de récupération de session :", error);
  }

  if(data && data.session && data.session.user){
    await loadUserProfile(data.session.user.id);
  } else {
    AUTH_USER = null;
  }

  AUTH_READY = true;
  render();

  window.supabase.auth.onAuthStateChange((event, session) => {
    if(event === "SIGNED_OUT"){
      AUTH_USER = null;
      AUTH_READY = true;
      render();
    } else if(
      event === "SIGNED_IN" ||
      event === "TOKEN_REFRESHED" ||
      event === "USER_UPDATED"
    ){
      if(session && session.user){
        loadUserProfile(session.user.id).then(() => {
          AUTH_READY = true;
          render();
        });
      }
    }
  });
}

